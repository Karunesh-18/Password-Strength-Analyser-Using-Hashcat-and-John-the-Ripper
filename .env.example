# Copy to .env.local and fill in. All of these are optional — the app is
# fully stateless with none set (see README.md "Optional: storage").

# Enables the analysis log (/history) and the vault (/vault). Unset = no
# storage, app behaves exactly as if this file didn't exist.
MONGODB_URI=mongodb://localhost:27017/pw-strength

# Required only for the vault: encrypts every saved password at rest
# (AES-256-GCM, key derived from this secret). Without it, vault writes
# fail loudly instead of ever storing a password unencrypted.
VAULT_SECRET=replace-with-a-long-random-string

# Optional: overrides the bundled ~100k-password dictionary with a bigger
# local wordlist (e.g. rockyou.txt). Absolute path recommended.
WORDLIST_PATH=/path/to/rockyou.txt
